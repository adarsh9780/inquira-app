{
  "name": "inquira-acc",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:worker": "NUXT_CLOUDFLARE_D1_BINDING=DB NITRO_PRESET=cloudflare_module nuxt build",
    "brand:icons": "node scripts/generateBrandIcons.mjs",
    "dev": "nuxt dev",
    "content:seed:sql": "node scripts/writeContentSeedSql.mjs",
    "deploy:worker": "npm run build:worker && npm run content:seed:sql && npm run wrangler:config && npx wrangler d1 execute \"$CLOUDFLARE_D1_DATABASE_NAME\" --remote --file .output/content-seed.sql --yes && npx wrangler deploy",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "preview:worker": "npm run build:worker && npm run wrangler:config && npx wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "verify:deployment": "node scripts/verifyDeployment.mjs",
    "wrangler:config": "node scripts/writeWranglerConfig.mjs"
  },
  "dependencies": {
    "@nuxt/content": "^3.12.0",
    "@nuxtjs/supabase": "^2.0.4",
    "better-sqlite3": "^12.8.0",
    "fuse.js": "^7.1.0",
    "nuxt": "^4.4.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.19"
  }
}
